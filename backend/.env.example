# GhostID Backend — environment variables
# Copy to .env and fill in values before starting.

PORT=8000

# Comma-separated list of allowed CORS origins (or JSON array).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Security ────────────────────────────────────────────────────────────────
# API key required on every request via X-GhostID-Key header.
# Leave empty to disable auth (dev only — never empty in production).
GHOSTID_API_KEY=

# Fernet key for encrypting stored embeddings at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to store plain JSON (dev only).
EMBEDDING_ENCRYPTION_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Max requests per user_id per minute on /enroll and /score.
RATE_LIMIT_PER_MINUTE=30

# ── Session hygiene ──────────────────────────────────────────────────────────
# Delete raw keystroke sessions older than N days.
SESSION_RETENTION_DAYS=30
# Keep at most N sessions per user for baseline computation.
MAX_SESSIONS_PER_USER=20

# ── ML ───────────────────────────────────────────────────────────────────────
ENCODER_PATH=ml/ghostid_encoder.onnx
SCALER_PATH=ml/scaler_params.json
MIN_SESSIONS_TO_SCORE=1
EMA_ALPHA=0.08

# ── Thresholds ───────────────────────────────────────────────────────────────
SILENT_PASS_THRESHOLD=85.0
SOFT_NUDGE_THRESHOLD=70.0
TYPING_CHALLENGE_THRESHOLD=40.0

LOG_LEVEL=INFO
